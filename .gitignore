# Local/editor
.DS_Store
__pycache__/
*.pyc
.env
.env.*
!apps/web/.env.example
.venv/
**/node_modules/
**/.next/

# Raw and downloaded media
**/materials/raw/**
**/materials/contact_sheets/**
**/materials/derived/**
**/references/**/*.mp4
**/references/**/*.mov
**/references/**/*.jpg
**/references/**/*.jpeg
**/references/**/*.png
**/references/**/frames/**
**/reference/**/*.mp4
**/reference/**/*.mov
**/reference/**/*.jpg
**/reference/**/*.jpeg
**/reference/**/*.png
**/materials/**/*.mp4
**/materials/**/*.mov
*.mov
*.m4v

# Generated video artifacts
**/main/*.mp4
**/output/**/preview_render/**
**/output/**/segments/**
**/output/**/overlays/**
**/output/**/qa_frames/**
**/output/**/*_workdir/**
**/output/**/*.mp4
**/output/**/*.mov
**/output/**/*.jpg
**/output/**/*.jpeg
**/output/**/*.png

# Avoid committing nested source repo metadata as submodules.
source-skills/**/.git/

# Keep structured project artifacts in Git when needed.
!**/output/**/*.json
!**/output/**/*.md
**/output/worker_run_status.json
**/output/worker_run.log
**/output/final_delivery/worker_render_report.json
**/output/final_delivery/captions.json
**/output/final_delivery/master.srt

# Final media should live in object storage, not Git.
**/output/final_delivery/*.mp4
**/output/final_delivery/*.jpg
**/output/final_delivery/*.png
*.zip

# Keep temporary preview work directories out of Git even when JSON artifacts are unignored above.
**/output/**/preview_render/**
.vercel
.env*.local
